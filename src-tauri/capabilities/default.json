{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Run local Python, and open/save project files the user picks.",
  "windows": ["main"],
  "permissions": [
    "core:default",

    "dialog:allow-open",
    "dialog:allow-save",

    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOWNLOAD/**" }
      ]
    },

    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "python", "cmd": "python", "args": true },
        { "name": "python3", "cmd": "python3", "args": true },
        { "name": "py", "cmd": "py", "args": true }
      ]
    }
  ]
}
